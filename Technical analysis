    "def calculate_52w_high_proximity(prices, window=252):\n",
    "    return (prices / prices.rolling(window).max()) * 100\n",
    "\n",
    "def calculate_resistance_breakout(close, window=60):\n",
    "    resistance = close.shift(1).rolling(window).max()\n",
    "    breakout = close > resistance\n",
    "    return resistance, breakout\n",
    "\n",
    "high52_results = []\n",
    "flagged_ca_52w = []\n",
    "\n",
    "for ticker in data_200.columns:\n",
    "    prices = data_200[ticker]\n",
    "\n",
    "    # Same corporate-action guard as MACD — even more critical here,\n",
    "    # since 52-week high is directly comparing today's price to history\n",
    "    daily_pct_change = prices.pct_change()\n",
    "    if (daily_pct_change.abs() > 0.15).any():\n",
    "        flagged_ca_52w.append(ticker)\n",
    "        continue\n",
    "\n",
    "    proximity = calculate_52w_high_proximity(prices)\n",
    "    latest_proximity = proximity.iloc[-1]\n",
    "\n",
    "    if pd.isna(latest_proximity):\n",
    "        continue  # not enough history yet\n",
    "\n",
    "    resistance, breakout = calculate_resistance_breakout(prices, window=60)\n",
    "    recent_breakout = breakout.tail(5).any()  # any breakout in the last week\n",
    "\n",
    "    if latest_proximity >= 98:\n",
    "        signal = \"At/near 52-week high\"\n",
    "    elif latest_proximity >= 90:\n",
    "        signal = \"Within striking distance\"\n",
    "    elif latest_proximity >= 75:\n",
