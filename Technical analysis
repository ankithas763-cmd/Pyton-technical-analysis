    "\n",
    "# Download 2 years of close prices for all 200\n",
    "data_200 = yf.download(tickers_200, period=\"2y\", auto_adjust=True, threads=True)[\"Close\"]\n",
    "\n",
    "# Diagnostics — same checks that saved us earlier\n",
    "print(f\"\\nColumns returned: {data_200.shape[1]} of {len(tickers_200)} requested\")\n",
    "\n",
    "fully_missing = [t for t in tickers_200 if t not in data_200.columns or data_200[t].isna().all()]\n",
    "print(f\"Fully missing/empty tickers ({len(fully_missing)}): {fully_missing}\")\n",
    "\n",
    "# Drop fully empty columns, forward-fill small gaps (same fix as before)\n",
    "data_200 = data_200.dropna(axis=1, how=\"all\")\n",
    "data_200 = data_200.ffill()\n",
    "\n",
    "# Check remaining data quality\n",
    "null_counts = data_200.isna().sum()\n",
    "still_gappy = null_counts[null_counts > 0]\n",
    "print(f\"\\nTickers with remaining gaps after ffill: {len(still_gappy)}\")\n",
