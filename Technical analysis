    "def calculate_moving_averages(prices, short_window=50, long_window=200):\n",
    "    ma_short = prices.rolling(short_window).mean()\n",
    "    ma_long = prices.rolling(long_window).mean()\n",
    "    return ma_short, ma_long\n",
    "\n",
    "ma_results = []\n",
    "for ticker in data_200.columns:\n",
    "    ma50, ma200 = calculate_moving_averages(data_200[ticker])\n",
    "    latest_ma50 = ma50.iloc[-1]\n",
    "    latest_ma200 = ma200.iloc[-1]\n",
    "\n",
    "    if pd.isna(latest_ma50) or pd.isna(latest_ma200):\n",
    "        continue  # skip recent IPOs without 200 days of history yet\n",
    "\n",
    "    # % gap between the two MAs — a magnitude, not just a direction\n",
    "    pct_gap = ((latest_ma50 - latest_ma200) / latest_ma200) * 100\n",
    "\n",
    "    # Detect an actual crossover in the last 10 trading days, not just current position\n",
    "    diff = ma50 - ma200\n",
    "    recent_diff = diff.tail(10)\n",
    "    crossed_golden = (recent_diff.iloc[0] < 0) and (recent_diff.iloc[-1] > 0)\n",
    "    crossed_death = (recent_diff.iloc[0] > 0) and (recent_diff.iloc[-1] < 0)\n",
    "\n",
    "    if latest_ma50 > latest_ma200:\n",
    "        signal = \"Golden Cross (recent!)\" if crossed_golden else \"Bullish trend\"\n",
    "    else:\n",
    "        signal = \"Death Cross (recent!)\" if crossed_death else \"Bearish trend\"\n",
    "\n",
    "    ma_results.append({\n",
    "        \"ticker\": ticker, \"ma_50\": round(latest_ma50, 2), \"ma_200\": round(latest_ma200, 2),\n",
    "        \"pct_gap\": round(pct_gap, 2), \"signal\": signal\n",
    "    })\n",
    "\n",
    "ma_table = pd.DataFrame(ma_results).set_index(\"ticker\").sort_values(\"pct_gap\", ascending=False)\n",
