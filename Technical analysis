    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Build tickers from the Nifty 200 list we just pulled\n",
    "tickers_200 = [symbol + \".NS\" for symbol in nifty200[\"Symbol\"]]\n",
