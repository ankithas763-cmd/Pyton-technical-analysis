    "def calculate_bollinger_bands(prices, window=20, num_std=2):\n",
    "    middle_band = prices.rolling(window).mean()\n",
    "    rolling_std = prices.rolling(window).std()\n",
    "    upper_band = middle_band + (num_std * rolling_std)\n",
    "    lower_band = middle_band - (num_std * rolling_std)\n",
    "    \n",
    "    # %B: where is price within the bands? 0 = at lower band, 1 = at upper band, >1 = above upper, <0 = below lower\n",
    "    percent_b = (prices - lower_band) / (upper_band - lower_band)\n",
    "    \n",
    "    # Bandwidth: how wide are the bands relative to price? Narrow bands = low volatility, often precedes a big move\n",
    "    bandwidth = (upper_band - lower_band) / middle_band * 100\n",
    "    \n",
    "    return middle_band, upper_band, lower_band, percent_b, bandwidth\n",
    "\n",
    "bb_results = []\n",
    "flagged_ca_bb = []\n",
    "\n",
    "for ticker in data_200.columns:\n",
    "    prices = data_200[ticker]\n",
    "\n",
    "    daily_pct_change = prices.pct_change()\n",
    "    if (daily_pct_change.abs() > 0.15).any():\n",
    "        flagged_ca_bb.append(ticker)\n",
    "        continue\n",
    "\n",
    "    middle, upper, lower, percent_b, bandwidth = calculate_bollinger_bands(prices)\n",
    "    \n",
    "    latest_percent_b = percent_b.iloc[-1]\n",
    "    latest_bandwidth = bandwidth.iloc[-1]\n",
    "    \n",
    "    if pd.isna(latest_percent_b):\n",
    "        continue\n",
    "\n",
    "    # Is bandwidth unusually narrow right now vs its own recent history? (a \"squeeze\" — often precedes a breakout)\n",
    "    bandwidth_percentile_own_history = (bandwidth.tail(252) < latest_bandwidth).mean() * 100\n",
    "\n",
    "    if latest_percent_b > 1.0:\n",
    "        signal = \"Above upper band — strong breakout or overbought\"\n",
    "    elif latest_percent_b > 0.8:\n",
    "        signal = \"Near upper band — strong/overbought zone\"\n",
    "    elif latest_percent_b < 0.0:\n",
    "        signal = \"Below lower band — strong breakdown or oversold\"\n",
    "    elif latest_percent_b < 0.2:\n",
    "        signal = \"Near lower band — weak/oversold zone\"\n",
    "    else:\n",
    "        signal = \"Middle range — no extreme\"\n",
    "\n",
    "    if bandwidth_percentile_own_history < 10:\n",
    "        signal += \" + SQUEEZE (unusually tight bands, watch for breakout)\"\n",
    "\n",
    "    bb_results.append({\n",
    "        \"ticker\": ticker,\n",
    "        \"percent_b\": round(latest_percent_b, 3),\n",
    "        \"bandwidth_pct\": round(latest_bandwidth, 2),\n",
    "        \"bandwidth_percentile_own_history\": round(bandwidth_percentile_own_history, 1),\n",
    "        \"signal\": signal\n",
    "    })\n",
    "\n",
